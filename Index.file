<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Weather Desk</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIINfQ3m4D6l7k4Kp9Q8g0qjY5f2d1b3f9A=" crossorigin="">
<style>
/* Layout: one column of stacked panels, a search bar on top, a hero reading, then
   hourly chart, detail tiles, 7-day range bars, and a model comparison table. */
:root {
  --bg: #eef2f5;
  --panel: #ffffff;
  --ink: #14212b;
  --ink-soft: #55697a;
  --line: #d9e1e8;
  --accent: #e8590c;       /* temperature */
  --accent-soft: #fde8da;
  --rain: #2b7fb8;         /* precipitation */
  --rain-soft: #cfe5f3;
  --warn-bg: #fff3cd;
  --warn-ink: #5c4400;
  --warn-line: #e6c34a;
  --font-display: "Bricolage Grotesque", "Avenir Next", "Segoe UI", sans-serif;
  --font-body: "Instrument Sans", "Segoe UI", system-ui, sans-serif;
  --font-data: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0e171e;
    --panel: #16222c;
    --ink: #e7eef4;
    --ink-soft: #94a8b8;
    --line: #27384a;
    --accent: #ff8a4c;
    --accent-soft: #3a2518;
    --rain: #5fb0e6;
    --rain-soft: #1c3a50;
    --warn-bg: #3a3012;
    --warn-ink: #f3dd95;
    --warn-line: #7a6620;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0e171e;
  --panel: #16222c;
  --ink: #e7eef4;
  --ink-soft: #94a8b8;
  --line: #27384a;
  --accent: #ff8a4c;
  --accent-soft: #3a2518;
  --rain: #5fb0e6;
  --rain-soft: #1c3a50;
  --warn-bg: #3a3012;
  --warn-ink: #f3dd95;
  --warn-line: #7a6620;
  color-scheme: dark;
}

* { box-sizing: border-box; }
html, body { margin: 0; }
body {
  background: var(--bg);
  color: var(--ink);
  font: 400 15px/1.5 var(--font-body);
  padding-inline: 16px;
  padding-block: 20px 48px;
  -webkit-font-smoothing: antialiased;
}
.wrap { max-width: 880px; margin-inline: auto; display: grid; gap: 14px; }
h1, h2, h3 { margin: 0; font-family: var(--font-display); text-wrap: balance; }
.mono { font-family: var(--font-data); font-variant-numeric: tabular-nums; }
button, input { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--rain); outline-offset: 2px; }

/* top bar */
.bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.brand { font: 700 18px/1 var(--font-display); letter-spacing: -0.01em; margin-right: auto; }
.search { position: relative; flex: 1 1 260px; min-width: 0; }
.search input {
  width: 100%; padding: 10px 12px; border-radius: 8px;
  border: 1px solid var(--line); background: var(--panel);
}
.results {
  position: absolute; inset-inline: 0; top: calc(100% + 4px); z-index: 5;
  background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
  box-shadow: 0 8px 24px rgb(0 0 0 / 0.14); overflow: hidden; margin: 0; padding: 0; list-style: none;
}
.results button {
  display: block; width: 100%; text-align: left; padding: 9px 12px; border: 0;
  background: none; cursor: pointer;
}
.results button:hover, .results button:focus-visible { background: var(--bg); }
.results small { color: var(--ink-soft); }
.btn {
  padding: 9px 13px; border-radius: 8px; border: 1px solid var(--line);
  background: var(--panel); cursor: pointer; white-space: nowrap;
}
.btn:hover { border-color: var(--ink-soft); }
.seg { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--panel); }
.seg button { border: 0; background: none; padding: 9px 12px; cursor: pointer; color: var(--ink-soft); }
.seg button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }

/* panels */
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 18px; min-width: 0; }
.label {
  font: 500 11px/1 var(--font-data); letter-spacing: 0.09em; text-transform: uppercase;
  color: var(--ink-soft);
}
.status { color: var(--ink-soft); font-size: 13px; display: flex; flex-wrap: wrap; gap: 4px 14px; }
.status .err { color: #b3261e; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .status .err { color: #ff8f86; } }

/* alerts */
.alert { background: var(--warn-bg); color: var(--warn-ink); border: 1px solid var(--warn-line); border-radius: 12px; padding: 12px 16px; }
.alert strong { font-family: var(--font-display); }
.alert p { margin: 4px 0 0; font-size: 13px; }

/* hero */
.hero { display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; }
.hero .place { font-size: 15px; color: var(--ink-soft); margin-bottom: 6px; }
.hero .temp { font: 700 clamp(64px, 16vw, 104px)/0.95 var(--font-display); letter-spacing: -0.04em; }
.hero .temp sup { font-size: 0.38em; font-weight: 500; vertical-align: top; position: relative; top: 0.18em; color: var(--accent); }
.hero .cond { font: 500 20px/1.2 var(--font-display); margin-top: 10px; }
.hero .sub { color: var(--ink-soft); margin-top: 4px; }
.hero .art { width: clamp(84px, 22vw, 140px); color: var(--ink); }
.hero .art svg { width: 100%; height: auto; display: block; }

/* chart */
.chart-wrap { overflow-x: auto; margin-top: 10px; }
.chart-wrap svg { display: block; width: 100%; min-width: 520px; height: auto; }
.c-grid { stroke: var(--line); stroke-width: 1; }
.c-line { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
.c-area { fill: var(--accent-soft); }
.c-bar { fill: var(--rain); opacity: 0.85; }
.c-bar-bg { fill: var(--rain-soft); }
.c-txt { fill: var(--ink-soft); font: 400 11px var(--font-data); }
.c-val { fill: var(--ink); font: 500 12px var(--font-data); }
.c-dot { fill: var(--accent); stroke: var(--panel); stroke-width: 2; }

/* tiles */
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
.tile { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px; min-width: 0; }
.tile .v { font: 600 24px/1.1 var(--font-display); margin-top: 10px; }
.tile .v small { font: 400 13px var(--font-body); color: var(--ink-soft); margin-left: 3px; }
.tile .n { color: var(--ink-soft); font-size: 13px; margin-top: 4px; }
.meter { height: 6px; border-radius: 3px; background: var(--line); margin-top: 10px; overflow: hidden; }
.meter i { display: block; height: 100%; background: var(--accent); border-radius: 3px; }

/* daily */
.days { display: grid; margin-top: 8px; }
.day { display: grid; grid-template-columns: 56px 34px minmax(0, 1fr); gap: 4px 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line); }
.day:first-child { border-top: 0; }
.day .dn { font-weight: 600; }
.day .di { width: 30px; color: var(--ink); }
.day .di svg { width: 100%; height: auto; display: block; }
.range { display: grid; grid-template-columns: 38px minmax(0, 1fr) 38px; gap: 10px; align-items: center; }
.range .lo { text-align: right; color: var(--ink-soft); }
.rail { position: relative; height: 8px; border-radius: 4px; background: var(--line); }
.rail i { position: absolute; top: 0; bottom: 0; border-radius: 4px; background: linear-gradient(90deg, var(--rain), var(--accent)); }
.day .meta { grid-column: 3; color: var(--ink-soft); font-size: 12px; display: flex; gap: 12px; flex-wrap: wrap; }
.pp { color: var(--rain); }

/* compare */
.tablewrap { overflow-x: auto; margin-top: 10px; }
table { border-collapse: collapse; width: 100%; min-width: 520px; font-size: 14px; }
th, td { padding: 9px 10px; text-align: right; border-top: 1px solid var(--line); white-space: nowrap; }
th:first-child, td:first-child { text-align: left; }
thead th { border-top: 0; color: var(--ink-soft); font: 500 11px var(--font-data); letter-spacing: 0.08em; text-transform: uppercase; }
td.spread { color: var(--ink-soft); }
td.wide { color: var(--accent); font-weight: 600; }
.note { color: var(--ink-soft); font-size: 12.5px; margin: 10px 0 0; }

/* embedded radar */
.radar-head { display:flex; justify-content:space-between; gap:12px; align-items:flex-start; }
.radar-title { font:600 20px/1.2 var(--font-display); margin-top:6px; }
.radar-status { color:var(--ink-soft); font:500 12px var(--font-data); white-space:nowrap; }
.radar-frame { width:100%; height:480px; display:block; border:0; border-radius:10px; background:var(--bg); margin-top:12px; overflow:hidden; }
.radar-image-wrap { width:100%; margin-top:12px; border-radius:10px; background:#dfe7ea; overflow:hidden; }
.radar-image { display:block; width:100%; height:auto; min-height:320px; object-fit:contain; background:#dfe7ea; }
.radar-fallback { padding:28px 18px; text-align:center; color:var(--ink-soft); }
@media (max-width:520px) { .radar-frame { height:380px; } .radar-head { flex-direction:column; } }

.loading { color: var(--ink-soft); padding: 40px 0; text-align: center; }
footer { color: var(--ink-soft); font-size: 12px; }
footer a { color: inherit; }

/* personal layer: saved places, greeting, settings */
.places { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 2px; }
.places:empty { display: none; }
.chip {
  flex: 0 0 auto; display: grid; grid-template-columns: auto 26px; gap: 0 8px; align-items: center;
  text-align: left; padding: 8px 12px; border-radius: 10px; border: 1px solid var(--line);
  background: var(--panel); cursor: pointer; min-width: 120px;
}
.chip:hover { border-color: var(--ink-soft); }
.chip[aria-current="true"] { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
.chip .cn { font-weight: 600; white-space: nowrap; }
.chip .ct { color: var(--ink-soft); font: 400 12px var(--font-data); grid-column: 1; }
.chip .ci { grid-column: 2; grid-row: 1 / span 2; width: 26px; }
.chip .ci svg { width: 100%; height: auto; display: block; }
.tag { font: 500 10px var(--font-data); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-left: 6px; }
.greet { font: 500 13px var(--font-data); letter-spacing: 0.04em; color: var(--accent); margin-bottom: 4px; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.btn.sm { padding: 6px 10px; font-size: 13px; }
details.settings summary { cursor: pointer; font: 600 15px var(--font-display); }
.settings .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--line); }
.settings .row:first-of-type { border-top: 0; }
.settings .row > span { min-width: 0; overflow-wrap: anywhere; }
.settings .acts { display: flex; gap: 8px; }
.settings label { display: grid; gap: 6px; margin-top: 14px; }
.settings input[type="text"] { padding: 10px 12px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); width: 100%; max-width: 320px; }
.account { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-top:10px; color:var(--ink-soft); font-size:13px; }
.account strong { color:var(--ink); }
.auth-panel { margin-top:14px; background:var(--bg); }
.auth-form { display:grid; gap:10px; margin-top:12px; }
.auth-form input { padding:10px 12px; border-radius:8px; border:1px solid var(--line); background:var(--panel); color:var(--ink); width:100%; box-sizing:border-box; }
.auth-actions { display:flex; gap:8px; flex-wrap:wrap; }
.auth-message { min-height:18px; color:var(--ink-soft); font-size:13px; }
.welcome { text-align: center; padding: 36px 18px; }
.welcome h2 { font-size: 26px; margin-bottom: 8px; }
.welcome p { color: var(--ink-soft); max-width: 44ch; margin: 0 auto 18px; }

@media (max-width: 520px) {
  .panel { padding: 14px; }
  .hero { grid-template-columns: 1fr; }
  .hero .art { width: 84px; }
  .day { grid-template-columns: 48px 28px minmax(0, 1fr); }
}
@media (prefers-reduced-motion: no-preference) {
  .panel, .tile { animation: rise 0.35s ease both; }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
}
</style>
</head>
<body>
<div class="wrap">
  <div class="bar">
    <h1 class="brand">Weather Desk</h1>
    <div class="search">
      <input id="q" type="search" placeholder="Search a city" autocomplete="off" aria-label="Search a city">
      <ul id="results" class="results" hidden></ul>
    </div>
    <button id="locate" class="btn" type="button">Use my location</button>
    <div class="seg" role="group" aria-label="Units">
      <button id="u-imperial" type="button" aria-pressed="true">°F</button>
      <button id="u-metric" type="button" aria-pressed="false">°C</button>
    </div>
    <button id="refresh" class="btn" type="button">Refresh</button>
  </div>
  <div id="status" class="status" aria-live="polite"></div>
  <div id="account" class="account" aria-live="polite"></div>
  <div id="places" class="places" aria-label="My places"></div>
  <div id="alerts"></div>
  <main id="main" class="wrap" style="gap:14px"><div class="loading">Loading forecast…</div></main>
  <details class="panel settings" id="settings">
    <summary>My settings</summary>
    <label for="name"><span class="label">Your name (used in the greeting)</span>
      <input id="name" type="text" maxlength="30" autocomplete="given-name" placeholder="Optional">
    </label>
    <div id="saved-list" style="margin-top:16px"></div>
    <p class="note" id="local-note">Everything here is stored only in this browser on this device.</p>
    <section class="panel auth-panel" id="auth-panel" hidden>
      <div class="label" id="auth-title">Log in to Weather Desk</div>
      <form class="auth-form" id="auth-form">
        <input id="auth-email" type="email" autocomplete="email" placeholder="Email" required>
        <input id="auth-password" type="password" autocomplete="current-password" placeholder="Password" minlength="6" required>
        <div class="auth-actions">
          <button class="btn sm" id="auth-submit" type="submit">Log in</button>
          <button class="btn sm" id="auth-cancel" type="button">Cancel</button>
        </div>
        <div class="auth-message" id="auth-message" aria-live="polite"></div>
      </form>
    </section>
    <p class="note" id="cloud-setup-note"><strong>Cloud sync:</strong> Accounts are connected to Supabase. Your saved places, home location, units, and name can then sync across devices.</p>
  </details>
  <footer>
    Forecasts from <a href="https://open-meteo.com/" target="_blank" rel="noopener">Open-Meteo</a> (best-match, GFS, ECMWF and ICON models).
    U.S. alerts from the <a href="https://www.weather.gov/" target="_blank" rel="noopener">National Weather Service</a>.
  </footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(function () {
  "use strict";

  var SUPABASE_URL = "https://hroskjsjljndybiofmww.supabase.co";
  var SUPABASE_KEY = "sb_publishable_IKDj2WVKCKYVYZyENZCspA_Ztd8vjWu";
  var cloud = { client: null, user: null, mode: "login" };

  var state = { place: null, units: "imperial", updated: null, saved: [], home: null, name: "", cur: {}, last: null };
  var $ = function (id) { return document.getElementById(id); };
  function key(p) { return Number(p.lat).toFixed(3) + "," + Number(p.lon).toFixed(3); }
  function isSaved(p) { return state.saved.some(function (s) { return key(s) === key(p); }); }
  function validPlace(p) { return p && typeof p.name === "string" && typeof p.lat === "number" && typeof p.lon === "number"; }

  /* ---------- storage ---------- */
  function cloudReady() {
    return !!(cloud.client && cloud.user);
  }
  function save() {
    try {
      localStorage.setItem("weather-desk", JSON.stringify({
        place: state.place, units: state.units, saved: state.saved, home: state.home, name: state.name
      }));
    } catch (e) {}
    if (cloudReady()) pushCloud();
  }

  async function pushCloud() {
    if (!cloudReady()) return;
    var payload = {
      user_id: cloud.user.id,
      data: { place: state.place, units: state.units, saved: state.saved, home: state.home, name: state.name },
      updated_at: new Date().toISOString()
    };
    var result = await cloud.client.from("weather_preferences").upsert(payload);
    if (result.error) console.warn("Weather Desk cloud save failed:", result.error.message);
  }

  async function pullCloud() {
    if (!cloudReady()) return;
    var result = await cloud.client.from("weather_preferences").select("data").eq("user_id", cloud.user.id).maybeSingle();
    if (result.error) { console.warn("Weather Desk cloud load failed:", result.error.message); return; }
    var d = result.data && result.data.data;
    if (!d) return;
    if (validPlace(d.place)) state.place = d.place;
    if (d.units === "metric" || d.units === "imperial") state.units = d.units;
    if (Array.isArray(d.saved)) state.saved = d.saved.filter(validPlace).slice(0, 12);
    if (typeof d.home === "string") state.home = d.home;
    if (typeof d.name === "string") state.name = d.name.slice(0, 30);
    try { localStorage.setItem("weather-desk", JSON.stringify({place:state.place,units:state.units,saved:state.saved,home:state.home,name:state.name})); } catch(e) {}
    $("name").value = state.name;
    setUnits(state.units);
    refreshPersonal();
    if (state.place) load();
  }

  function renderAccount() {
    var el = $("account");
    if (!el) return;
    if (cloud.user) {
      el.innerHTML = '<span>Signed in as <strong>' + esc(cloud.user.email || "account") + '</strong></span><button class="btn sm" id="account-logout" type="button">Log out</button>';
      $("account-logout").addEventListener("click", async function () {
        var r = await cloud.client.auth.signOut({scope:"local"});
        if (r.error) { el.innerHTML = '<span class="err">' + esc(r.error.message) + '</span>'; return; }
        cloud.user = null; renderAccount();
      });
    } else if (cloud.client) {
      el.innerHTML = '<span>Cloud sync is ready</span><button class="btn sm" id="account-login" type="button">Log in</button><button class="btn sm" id="account-signup" type="button">Sign up</button>';
      $("account-login").addEventListener("click", function(){ openAuth("login"); });
      $("account-signup").addEventListener("click", function(){ openAuth("signup"); });
    } else {
      el.innerHTML = '<span>Local-only mode</span>';
    }
  }

  function openAuth(mode) {
    cloud.mode = mode;
    $("auth-panel").hidden = false;
    $("auth-title").textContent = mode === "signup" ? "Create a Weather Desk account" : "Log in to Weather Desk";
    $("auth-submit").textContent = mode === "signup" ? "Create account" : "Log in";
    $("auth-password").autocomplete = mode === "signup" ? "new-password" : "current-password";
    $("auth-message").textContent = "";
    $("auth-email").focus();
  }

  async function submitAuth() {
    var email = $("auth-email").value.trim();
    var password = $("auth-password").value;
    var msg = $("auth-message");
    msg.textContent = "Working…";
    var result = cloud.mode === "signup"
      ? await cloud.client.auth.signUp({ email: email, password: password, options: { emailRedirectTo: window.location.href } })
      : await cloud.client.auth.signInWithPassword({ email: email, password: password });
    if (result.error) { msg.textContent = result.error.message; return; }
    if (cloud.mode === "signup" && result.data && result.data.user && !result.data.session) {
      msg.textContent = "Account created. Check your email to confirm it, then log in.";
      return;
    }
    cloud.user = result.data.user;
    $("auth-panel").hidden = true;
    $("auth-form").reset();
    renderAccount();
    await pullCloud();
  }

  async function initCloud() {
    if (typeof window.supabase === "undefined" || SUPABASE_URL.indexOf("YOUR_") === 0 || SUPABASE_KEY.indexOf("YOUR_") === 0) {
      renderAccount();
      return;
    }
    cloud.client = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    var sessionResult = await cloud.client.auth.getSession();
    cloud.user = sessionResult.data && sessionResult.data.session ? sessionResult.data.session.user : null;
    renderAccount();
    if (cloud.user) await pullCloud();
    cloud.client.auth.onAuthStateChange(function (_event, session) {
      cloud.user = session ? session.user : null;
      renderAccount();
      if (cloud.user) pullCloud();
    });
  }
  function restore() {
    try {
      var s = JSON.parse(localStorage.getItem("weather-desk") || "null");
      if (!s) return;
      if (validPlace(s.place)) state.place = s.place;
      if (s.units === "metric" || s.units === "imperial") state.units = s.units;
      if (Array.isArray(s.saved)) state.saved = s.saved.filter(validPlace).slice(0, 12);
      if (typeof s.home === "string") state.home = s.home;
      if (typeof s.name === "string") state.name = s.name.slice(0, 30);
    } catch (e) {}
  }
  function homePlace() {
    for (var i = 0; i < state.saved.length; i++) if (key(state.saved[i]) === state.home) return state.saved[i];
    return null;
  }
  function greeting() {
    if (!state.name) return "";
    var h = new Date().getHours();
    return (h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening") + ", " + state.name;
  }

  /* ---------- helpers ---------- */
  function esc(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }
  function getJSON(url) {
    return fetch(url).then(function (r) {
      if (!r.ok) throw new Error("Request failed (" + r.status + ")");
      return r.json();
    });
  }
  function round(n) { return n == null ? "–" : Math.round(n); }
  function isImp() { return state.units === "imperial"; }
  var TU = function () { return isImp() ? "°F" : "°C"; };
  function fmtTime(s) {
    if (!s) return "–";
    var h = parseInt(s.slice(11, 13), 10), m = s.slice(14, 16);
    var ap = h >= 12 ? "PM" : "AM";
    h = h % 12 || 12;
    return h + ":" + m + " " + ap;
  }
  function fmtHour(s) {
    var h = parseInt(s.slice(11, 13), 10);
    var ap = h >= 12 ? "PM" : "AM";
    return (h % 12 || 12) + " " + ap;
  }
  function dayLabel(dateStr, i) {
    if (i === 0) return "Today";
    var p = dateStr.split("-");
    return new Date(+p[0], +p[1] - 1, +p[2]).toLocaleDateString(undefined, { weekday: "short" });
  }
  function longDay(dateStr) {
    var p = dateStr.split("-");
    return new Date(+p[0], +p[1] - 1, +p[2]).toLocaleDateString(undefined, { weekday: "long" });
  }
  function compass(deg) {
    var d = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"];
    return d[Math.round(deg / 22.5) % 16];
  }

  /* ---------- weather codes and icons ---------- */
  function describe(code) {
    if (code === 0) return "Clear";
    if (code === 1) return "Mostly clear";
    if (code === 2) return "Partly cloudy";
    if (code === 3) return "Overcast";
    if (code === 45 || code === 48) return "Fog";
    if (code >= 51 && code <= 57) return "Drizzle";
    if (code === 61 || code === 63) return "Rain";
    if (code === 65) return "Heavy rain";
    if (code === 66 || code === 67) return "Freezing rain";
    if (code === 71 || code === 73) return "Snow";
    if (code === 75) return "Heavy snow";
    if (code === 77) return "Snow grains";
    if (code >= 80 && code <= 82) return "Rain showers";
    if (code === 85 || code === 86) return "Snow showers";
    if (code === 95) return "Thunderstorm";
    if (code === 96 || code === 99) return "Thunderstorm with hail";
    return "Unknown";
  }
  var CLOUD = '<path d="M7 18a4 4 0 0 1-.5-7.97A5.5 5.5 0 0 1 17 8.6 4.7 4.7 0 0 1 17.5 18z"/>';
  function sun(cx, cy, r) {
    var rays = "";
    for (var i = 0; i < 8; i++) {
      var a = i * Math.PI / 4, x1 = cx + Math.cos(a) * (r + 2), y1 = cy + Math.sin(a) * (r + 2),
          x2 = cx + Math.cos(a) * (r + 4.2), y2 = cy + Math.sin(a) * (r + 4.2);
      rays += '<line x1="' + x1.toFixed(1) + '" y1="' + y1.toFixed(1) + '" x2="' + x2.toFixed(1) + '" y2="' + y2.toFixed(1) + '"/>';
    }
    return '<g style="stroke:var(--accent)"><circle cx="' + cx + '" cy="' + cy + '" r="' + r + '"/>' + rays + '</g>';
  }
  function moon(cx, cy) {
    return '<path style="stroke:var(--rain)" d="M' + (cx + 3) + ' ' + (cy - 7) + 'a7 7 0 1 0 5 12 6 6 0 0 1-5-12z"/>';
  }
  function icon(code, isDay) {
    var body;
    if (code === 0 || code === 1) {
      body = isDay ? sun(12, 12, 4.6) : moon(10, 12);
    } else if (code === 2) {
      body = (isDay ? sun(8, 8, 3.2) : moon(7, 8)) + '<g transform="translate(1.5 2)">' + CLOUD + "</g>";
    } else if (code === 3) {
      body = CLOUD;
    } else if (code === 45 || code === 48) {
      body = '<g transform="translate(0 -3)">' + CLOUD + '</g><path d="M5 20h14M8 22.5h8"/>';
    } else if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) {
      body = '<g transform="translate(0 -3)">' + CLOUD + '</g><g style="stroke:var(--rain)"><path d="M8 19.5l-1 2.5M12 19.5l-1 2.5M16 19.5l-1 2.5"/></g>';
    } else if ((code >= 71 && code <= 77) || code === 85 || code === 86) {
      body = '<g transform="translate(0 -3)">' + CLOUD + '</g><g style="stroke:var(--rain)"><path d="M8 20.5v.1M12 22v.1M16 20.5v.1M10 23v.1M14 23v.1"/></g>';
    } else if (code >= 95) {
      body = '<g transform="translate(0 -3)">' + CLOUD + '</g><path style="stroke:var(--accent)" d="M12.5 15l-2.5 4h3l-2 4"/>';
    } else {
      body = CLOUD;
    }
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + body + "</svg>";
  }

  /* ---------- data ---------- */
  function forecastURL(p) {
    var imp = isImp();
    return "https://api.open-meteo.com/v1/forecast?latitude=" + p.lat + "&longitude=" + p.lon +
      "&current=temperature_2m,apparent_temperature,relative_humidity_2m,precipitation,weather_code,wind_speed_10m,wind_direction_10m,wind_gusts_10m,surface_pressure,is_day,cloud_cover" +
      "&hourly=temperature_2m,precipitation_probability,weather_code" +
      "&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,uv_index_max,precipitation_sum,precipitation_probability_max,wind_speed_10m_max" +
      "&timezone=auto&forecast_days=7" +
      "&temperature_unit=" + (imp ? "fahrenheit" : "celsius") +
      "&wind_speed_unit=" + (imp ? "mph" : "kmh") +
      "&precipitation_unit=" + (imp ? "inch" : "mm");
  }
  function compareURL(p) {
    var imp = isImp();
    return "https://api.open-meteo.com/v1/forecast?latitude=" + p.lat + "&longitude=" + p.lon +
      "&daily=temperature_2m_max,temperature_2m_min&models=gfs_seamless,ecmwf_ifs025,icon_seamless" +
      "&timezone=auto&forecast_days=4&temperature_unit=" + (imp ? "fahrenheit" : "celsius");
  }
  function alertsURL(p) {
    return "https://api.weather.gov/alerts/active?point=" + p.lat.toFixed(4) + "," + p.lon.toFixed(4);
  }

  var loadId = 0;
  function renderWelcome() {
    $("alerts").innerHTML = "";
    $("status").textContent = "";
    $("main").innerHTML = '<section class="panel welcome"><h2>' + esc(state.name ? "Welcome, " + state.name : "Your weather, your places") + "</h2>" +
      "<p>Pick a home location to get started. Search for a city above, or let your browser share your location. You can save more places and switch between them with one tap.</p>" +
      '<button class="btn" type="button" data-act="locate">Use my location</button></section>';
  }
  function load() {
    if (!state.place) { renderWelcome(); drawPlaces(); renderSettings(); return; }
    var id = ++loadId;
    var p = state.place;
    drawPlaces();
    fetchPlaceTemps();
    renderSettings();
    setStatus("Updating…");
    $("refresh").disabled = true;
    var main = getJSON(forecastURL(p));
    var cmp = getJSON(compareURL(p)).catch(function () { return null; });
    var alr = getJSON(alertsURL(p)).catch(function () { return null; });
    Promise.all([main, cmp, alr]).then(function (r) {
      if (id !== loadId) return;
      state.updated = new Date();
      state.last = { d: r[0], c: r[1] };
      renderAlerts(r[2]);
      renderMain(r[0], r[1]);
      setStatus();
    }).catch(function (e) {
      if (id !== loadId) return;
      setStatus(null, "Could not load the forecast: " + e.message + ". Check your connection and press Refresh.");
    }).then(function () { if (id === loadId) $("refresh").disabled = false; });
  }
  function setStatus(msg, err) {
    var el = $("status");
    if (err) { el.innerHTML = '<span class="err">' + esc(err) + "</span>"; return; }
    if (msg) { el.textContent = msg; return; }
    var t = state.updated ? state.updated.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" }) : "";
    el.innerHTML = "<span>Updated " + esc(t) + "</span><span>Refreshes every 15 minutes</span>";
  }

  /* ---------- render ---------- */
  function renderAlerts(data) {
    var el = $("alerts");
    var feats = data && data.features ? data.features : [];
    if (!feats.length) { el.innerHTML = ""; return; }
    el.innerHTML = feats.slice(0, 3).map(function (f) {
      var pr = f.properties || {};
      var until = pr.ends || pr.expires;
      var u = until ? " until " + new Date(until).toLocaleString(undefined, { weekday: "short", hour: "numeric", minute: "2-digit" }) : "";
      return '<div class="alert" role="alert" style="margin-bottom:10px"><strong>' + esc(pr.event || "Weather alert") + esc(u) +
        "</strong><p>" + esc(pr.headline || "") + "</p></div>";
    }).join("");
  }

  var radar = { img: null, request: 0 };

  function initRadar(place) {
    var img = $("radar-image");
    if (!img) return;
    var req = ++radar.request;
    radar.img = img;
    var status = $("radar-status");
    var time = $("radar-time");
    if (status) status.textContent = "Loading NWS radar…";
    if (time) time.textContent = "";
    var base = "https://radar.weather.gov/ridge/standard/CONUS-LARGE_0.gif";
    img.onload = function () { if (req === radar.request) { if (status) status.textContent = "Live NWS radar"; if (time) time.textContent = "Latest scan"; } };
    img.onerror = function () { if (req === radar.request && status) status.textContent = "Radar image unavailable"; };
    img.src = base + "?t=" + Date.now();
  }

  function renderMain(d, c) {
    var cur = d.current, hr = d.hourly, dy = d.daily, imp = isImp();
    var place = state.place;
    var wind = imp ? "mph" : "km/h", prU = imp ? "in" : "mm";

    // hours starting at the current hour
    var start = 0;
    for (var i = 0; i < hr.time.length; i++) { if (hr.time[i] >= cur.time.slice(0, 13) + ":00") { start = i; break; } }
    var hours = [];
    for (var k = start; k < Math.min(start + 24, hr.time.length); k++) {
      hours.push({ t: hr.time[k], temp: hr.temperature_2m[k], pp: hr.precipitation_probability[k] || 0 });
    }

    var html = "";

    // hero
    var g = greeting();
    var saved = isSaved(place), isHome = saved && key(place) === state.home;
    var actions = '<button class="btn sm" type="button" data-act="toggle">' + (saved ? "Remove from my places" : "Save to my places") + "</button>" +
      (saved && !isHome ? '<button class="btn sm" type="button" data-act="home" data-k="' + esc(key(place)) + '">Make this home</button>' : "");
    html += '<section class="panel hero"><div>' +
      (g ? '<div class="greet">' + esc(g) + "</div>" : "") +
      '<div class="place">' + esc(place.name) + (isHome ? '<span class="tag">Home</span>' : "") + (place.admin ? " · " + esc(place.admin) : "") + "</div>" +
      '<div class="temp">' + round(cur.temperature_2m) + "<sup>" + TU() + "</sup></div>" +
      '<div class="cond">' + esc(describe(cur.weather_code)) + "</div>" +
      '<div class="sub mono">Feels like ' + round(cur.apparent_temperature) + "° · H " + round(dy.temperature_2m_max[0]) + "° · L " + round(dy.temperature_2m_min[0]) + "°</div>" +
      '<div class="hero-actions">' + actions + "</div>" +
      '</div><div class="art">' + icon(cur.weather_code, cur.is_day === 1) + "</div></section>";

    // radar — use the NWS published radar image directly for maximum reliability.
    var radarUrl = 'https://radar.weather.gov/location?lat=' + encodeURIComponent(place.lat) + '&lon=' + encodeURIComponent(place.lon);
    html += '<section class="panel radar-panel">' +
      '<div class="radar-head"><div><div class="label">Live precipitation radar</div><div class="radar-title">National Weather Service radar</div></div>' +
      '<span class="radar-status" id="radar-status">Loading NWS radar…</span></div>' +
      '<div class="radar-image-wrap"><img id="radar-image" class="radar-image" alt="Latest National Weather Service radar for the continental United States" loading="eager"></div>' +
      '<div class="radar-controls"><span class="radar-time mono" id="radar-time">Loading…</span></div>' +
      '<p class="note">Live NWS radar image. The interactive button opens the official NWS radar centered on your searched location.</p>' +
      '<p style="margin-top:10px"><a class="btn sm" href="' + radarUrl + '" target="_blank" rel="noopener">Open interactive NWS radar</a></p>' +
      '</section>';

    // hourly chart
    html += '<section class="panel"><div class="label">Next 24 hours</div><div class="chart-wrap">' + chart(hours) + "</div></section>";

    // tiles
    var uv = dy.uv_index_max[0];
    var uvTxt = uv == null ? "–" : uv < 3 ? "Low" : uv < 6 ? "Moderate" : uv < 8 ? "High" : uv < 11 ? "Very high" : "Extreme";
    var pres = imp ? (cur.surface_pressure * 0.02953).toFixed(2) : Math.round(cur.surface_pressure);
    html += '<section class="tiles">' +
      tile("Wind", round(cur.wind_speed_10m), wind, compass(cur.wind_direction_10m) + (cur.wind_gusts_10m != null ? ", gusts " + round(cur.wind_gusts_10m) : "")) +
      tile("Humidity", round(cur.relative_humidity_2m), "%", "Cloud cover " + round(cur.cloud_cover) + "%", cur.relative_humidity_2m) +
      tile("Rain today", dy.precipitation_sum[0] == null ? "–" : dy.precipitation_sum[0], prU, (dy.precipitation_probability_max[0] == null ? "–" : dy.precipitation_probability_max[0]) + "% chance") +
      tile("UV index", uv == null ? "–" : round(uv), "", uvTxt, uv == null ? null : Math.min(100, uv / 11 * 100)) +
      tile("Pressure", pres, imp ? "inHg" : "hPa", "") +
      tile("Sun", fmtTime(dy.sunrise[0]), "", "Sets " + fmtTime(dy.sunset[0])) +
      "</section>";

    // 7-day
    var gmin = Math.min.apply(null, dy.temperature_2m_min), gmax = Math.max.apply(null, dy.temperature_2m_max);
    var span = (gmax - gmin) || 1;
    html += '<section class="panel"><div class="label">7-day forecast</div><div class="days">';
    for (var j = 0; j < dy.time.length; j++) {
      var lo = dy.temperature_2m_min[j], hi = dy.temperature_2m_max[j];
      var left = ((lo - gmin) / span * 100).toFixed(1), width = Math.max(4, (hi - lo) / span * 100).toFixed(1);
      html += '<div class="day"><div class="dn">' + dayLabel(dy.time[j], j) + '</div><div class="di">' + icon(dy.weather_code[j], true) + "</div>" +
        '<div><div class="range mono"><span class="lo">' + round(lo) + '°</span><div class="rail"><i style="left:' + left + "%;width:" + width + '%"></i></div><span>' + round(hi) + "°</span></div>" +
        '<div class="meta"><span>' + esc(describe(dy.weather_code[j])) + '</span><span class="pp mono">' + (dy.precipitation_probability_max[j] == null ? "–" : dy.precipitation_probability_max[j]) + "% rain</span>" +
        '<span class="mono">Wind ' + round(dy.wind_speed_10m_max[j]) + " " + wind + "</span></div></div></div>";
    }
    html += "</div></section>";

    // model comparison
    html += compareTable(dy, c);

    $("main").innerHTML = html;
    initRadar(place);
  }

  function tile(label, value, unit, note, pct) {
    return '<div class="tile"><div class="label">' + esc(label) + '</div><div class="v">' + esc(value) +
      (unit ? "<small>" + esc(unit) + "</small>" : "") + "</div>" +
      (pct != null ? '<div class="meter"><i style="width:' + Math.max(0, Math.min(100, pct)).toFixed(0) + '%"></i></div>' : "") +
      (note ? '<div class="n">' + esc(note) + "</div>" : "") + "</div>";
  }

  function chart(hours) {
    var n = hours.length;
    if (n < 2) return '<p class="note">Not enough hourly data.</p>';
    var W = 720, H = 236, L = 36, R = 16, top = 24, base = 150, barBase = 198, barMax = 34;
    var temps = hours.map(function (h) { return h.temp; });
    var tmin = Math.min.apply(null, temps), tmax = Math.max.apply(null, temps);
    if (tmax - tmin < 4) { tmax += 2; tmin -= 2; }
    var lo = tmin - (tmax - tmin) * 0.08, hi = tmax + (tmax - tmin) * 0.08;
    function X(i) { return L + i * (W - L - R) / (n - 1); }
    function Y(v) { return base - (v - lo) / (hi - lo) * (base - top); }
    var s = '<svg viewBox="0 0 ' + W + " " + H + '" role="img" aria-label="Hourly temperature and chance of rain for the next 24 hours">';
    for (var g = 0; g <= 2; g++) {
      var v = lo + (hi - lo) * g / 2, y = Y(v);
      s += '<line class="c-grid" x1="' + L + '" x2="' + (W - R) + '" y1="' + y.toFixed(1) + '" y2="' + y.toFixed(1) + '"/>' +
        '<text class="c-txt" x="' + (L - 6) + '" y="' + (y + 4).toFixed(1) + '" text-anchor="end">' + Math.round(v) + "°</text>";
    }
    var pts = hours.map(function (h, i) { return X(i).toFixed(1) + "," + Y(h.temp).toFixed(1); });
    s += '<polygon class="c-area" points="' + X(0).toFixed(1) + "," + base + " " + pts.join(" ") + " " + X(n - 1).toFixed(1) + "," + base + '"/>';
    s += '<polyline class="c-line" points="' + pts.join(" ") + '"/>';
    // precip bars
    var bw = Math.max(4, (W - L - R) / (n - 1) * 0.62);
    s += '<text class="c-txt" x="' + L + '" y="' + (barBase - barMax - 6) + '">Chance of rain</text>';
    hours.forEach(function (h, i) {
      var bh = Math.max(1.5, h.pp / 100 * barMax);
      s += '<rect class="c-bar-bg" x="' + (X(i) - bw / 2).toFixed(1) + '" y="' + (barBase - barMax) + '" width="' + bw.toFixed(1) + '" height="' + barMax + '" rx="2"/>' +
        '<rect class="c-bar" x="' + (X(i) - bw / 2).toFixed(1) + '" y="' + (barBase - bh).toFixed(1) + '" width="' + bw.toFixed(1) + '" height="' + bh.toFixed(1) + '" rx="2"/>';
    });
    // hour labels
    hours.forEach(function (h, i) {
      if (i % 4 === 0) s += '<text class="c-txt" x="' + X(i).toFixed(1) + '" y="' + (H - 12) + '" text-anchor="' + (i === 0 ? "start" : "middle") + '">' + (i === 0 ? "Now" : fmtHour(h.t)) + "</text>";
    });
    // now and peak markers
    var pk = temps.indexOf(Math.max.apply(null, temps));
    s += '<circle class="c-dot" cx="' + X(0).toFixed(1) + '" cy="' + Y(hours[0].temp).toFixed(1) + '" r="5"/>';
    if (pk > 1 && pk < n - 1) {
      s += '<circle class="c-dot" cx="' + X(pk).toFixed(1) + '" cy="' + Y(hours[pk].temp).toFixed(1) + '" r="4"/>' +
        '<text class="c-val" x="' + X(pk).toFixed(1) + '" y="' + (Y(hours[pk].temp) - 10).toFixed(1) + '" text-anchor="middle">' + Math.round(hours[pk].temp) + "°</text>";
    }
    s += '<text class="c-val" x="' + (X(0) + 10).toFixed(1) + '" y="' + (Y(hours[0].temp) - 10).toFixed(1) + '">' + Math.round(hours[0].temp) + "°</text>";
    return s + "</svg>";
  }

  function compareTable(dy, c) {
    if (!c || !c.daily) return "";
    var d = c.daily;
    var models = [
      { key: "gfs_seamless", name: "GFS" },
      { key: "ecmwf_ifs025", name: "ECMWF" },
      { key: "icon_seamless", name: "ICON" }
    ];
    var rows = "";
    var count = Math.min(4, d.time.length);
    for (var i = 0; i < count; i++) {
      var vals = [{ n: "Best match", hi: dy.temperature_2m_max[i], lo: dy.temperature_2m_min[i] }];
      models.forEach(function (m) {
        vals.push({ n: m.name, hi: (d["temperature_2m_max_" + m.key] || [])[i], lo: (d["temperature_2m_min_" + m.key] || [])[i] });
      });
      var his = vals.map(function (v) { return v.hi; }).filter(function (v) { return v != null; });
      var spread = his.length > 1 ? Math.max.apply(null, his) - Math.min.apply(null, his) : null;
      var thr = isImp() ? 6 : 3.5;
      rows += "<tr><td>" + esc(i === 0 ? "Today" : longDay(d.time[i])) + "</td>" +
        vals.map(function (v) { return '<td class="mono">' + (v.hi == null ? "–" : round(v.hi) + "°") + ' <span style="color:var(--ink-soft)">/ ' + (v.lo == null ? "–" : round(v.lo) + "°") + "</span></td>"; }).join("") +
        '<td class="mono ' + (spread != null && spread >= thr ? "wide" : "spread") + '">' + (spread == null ? "–" : spread.toFixed(1) + "°") + "</td></tr>";
    }
    return '<section class="panel"><div class="label">Do the models agree?</div>' +
      '<div class="tablewrap"><table><thead><tr><th>Day</th><th>Best match</th><th>GFS</th><th>ECMWF</th><th>ICON</th><th>High spread</th></tr></thead><tbody>' + rows + "</tbody></table></div>" +
      '<p class="note">Each cell shows high / low. A wide spread in the highs means the forecast models disagree, so treat that day with less confidence.</p></section>';
  }

  /* ---------- my places ---------- */
  function orderedSaved() {
    return state.saved.slice().sort(function (a, b) {
      return (key(b) === state.home ? 1 : 0) - (key(a) === state.home ? 1 : 0);
    });
  }
  function drawPlaces() {
    var el = $("places");
    if (!state.saved.length) { el.innerHTML = ""; return; }
    el.innerHTML = orderedSaved().map(function (p) {
      var k = key(p), c = state.cur[k + "|" + state.units];
      var active = state.place && key(state.place) === k;
      return '<button class="chip" type="button" data-act="go" data-k="' + esc(k) + '"' + (active ? ' aria-current="true"' : "") + ">" +
        '<span class="cn">' + esc(p.name) + (k === state.home ? '<span class="tag">Home</span>' : "") + "</span>" +
        '<span class="ci">' + (c ? icon(c.weather_code, c.is_day === 1) : "") + "</span>" +
        '<span class="ct">' + (c ? round(c.temperature_2m) + TU() + " · " + esc(describe(c.weather_code)) : "…") + "</span></button>";
    }).join("");
  }
  var placesReq = 0;
  function fetchPlaceTemps() {
    if (!state.saved.length) return;
    var id = ++placesReq, list = orderedSaved(), imp = isImp(), units = state.units;
    var url = "https://api.open-meteo.com/v1/forecast?latitude=" + list.map(function (p) { return p.lat; }).join(",") +
      "&longitude=" + list.map(function (p) { return p.lon; }).join(",") +
      "&current=temperature_2m,weather_code,is_day&timezone=auto&temperature_unit=" + (imp ? "fahrenheit" : "celsius");
    getJSON(url).then(function (r) {
      if (id !== placesReq) return;
      var arr = Array.isArray(r) ? r : [r];
      arr.forEach(function (x, i) { if (list[i] && x && x.current) state.cur[key(list[i]) + "|" + units] = x.current; });
      drawPlaces();
    }).catch(function () {});
  }
  function renderSettings() {
    var el = $("saved-list");
    if (!state.saved.length) {
      el.innerHTML = '<p class="note" style="margin:0">No saved places yet. Open a city and choose “Save to my places”.</p>';
      return;
    }
    el.innerHTML = '<div class="label" style="margin-bottom:6px">My places</div>' + orderedSaved().map(function (p) {
      var k = key(p), home = k === state.home;
      return '<div class="row"><span>' + esc(p.name) + (home ? '<span class="tag">Home</span>' : "") +
        (p.admin ? ' <small style="color:var(--ink-soft)">' + esc(p.admin) + "</small>" : "") + '</span><span class="acts">' +
        (home ? "" : '<button class="btn sm" type="button" data-act="home" data-k="' + esc(k) + '">Make home</button>') +
        '<button class="btn sm" type="button" data-act="remove" data-k="' + esc(k) + '">Remove</button></span></div>';
    }).join("");
  }
  function refreshPersonal() {
    save();
    drawPlaces();
    renderSettings();
    if (state.last && state.place) renderMain(state.last.d, state.last.c);
    fetchPlaceTemps();
  }
  function toggleSaved() {
    var p = state.place;
    if (!p) return;
    if (isSaved(p)) {
      state.saved = state.saved.filter(function (s) { return key(s) !== key(p); });
      if (state.home === key(p)) state.home = state.saved.length ? key(state.saved[0]) : null;
    } else {
      if (state.saved.length >= 12) { setStatus(null, "You can save up to 12 places. Remove one first."); return; }
      state.saved.push({ name: p.name, admin: p.admin, lat: p.lat, lon: p.lon });
      if (!state.home) state.home = key(p);
    }
    refreshPersonal();
  }

  /* ---------- search ---------- */
  var timer = null;
  function search(q) {
    var box = $("results");
    if (q.length < 2) { box.hidden = true; return; }
    getJSON("https://geocoding-api.open-meteo.com/v1/search?name=" + encodeURIComponent(q) + "&count=6&language=en&format=json").then(function (r) {
      if ($("q").value.trim() !== q) return;
      var list = r.results || [];
      if (!list.length) { box.innerHTML = '<li><button type="button" disabled>No matches</button></li>'; box.hidden = false; return; }
      box.innerHTML = list.map(function (p, i) {
        var admin = [p.admin1, p.country].filter(Boolean).join(", ");
        return '<li><button type="button" data-i="' + i + '">' + esc(p.name) + " <small>" + esc(admin) + "</small></button></li>";
      }).join("");
      box.hidden = false;
      box._list = list;
    }).catch(function () { box.hidden = true; });
  }
  function choose(p) {
    state.place = { name: p.name, admin: [p.admin1, p.country].filter(Boolean).join(", "), lat: p.latitude, lon: p.longitude };
    $("q").value = "";
    $("results").hidden = true;
    save();
    load();
  }

  /* ---------- wiring ---------- */
  $("q").addEventListener("input", function () {
    clearTimeout(timer);
    var q = this.value.trim();
    timer = setTimeout(function () { search(q); }, 250);
  });
  $("results").addEventListener("click", function (e) {
    var b = e.target.closest("button[data-i]");
    if (b && this._list) choose(this._list[+b.getAttribute("data-i")]);
  });
  document.addEventListener("click", function (e) {
    if (!e.target.closest(".search")) $("results").hidden = true;
  });
  $("q").addEventListener("keydown", function (e) {
    if (e.key === "Enter") {
      var first = $("results").querySelector("button[data-i]");
      if (first) first.click();
    }
    if (e.key === "Escape") $("results").hidden = true;
  });
  $("refresh").addEventListener("click", load);
  function setUnits(u) {
    state.units = u;
    $("u-imperial").setAttribute("aria-pressed", u === "imperial");
    $("u-metric").setAttribute("aria-pressed", u === "metric");
    save();
  }
  $("u-imperial").addEventListener("click", function () { if (state.units !== "imperial") { setUnits("imperial"); load(); } });
  $("u-metric").addEventListener("click", function () { if (state.units !== "metric") { setUnits("metric"); load(); } });
  $("locate").addEventListener("click", function () {
    if (!navigator.geolocation) { setStatus(null, "This browser cannot share your location. Search for a city instead."); return; }
    setStatus("Finding your location…");
    navigator.geolocation.getCurrentPosition(function (pos) {
      var lat = pos.coords.latitude, lon = pos.coords.longitude;
      state.place = { name: "Your location", admin: lat.toFixed(2) + ", " + lon.toFixed(2), lat: lat, lon: lon };
      save();
      load();
    }, function () {
      setStatus(null, "Location was blocked. Search for a city instead.");
    }, { timeout: 10000, maximumAge: 600000 });
  });
  setInterval(function () { if (!document.hidden) load(); }, 15 * 60 * 1000);
  document.addEventListener("visibilitychange", function () {
    if (!document.hidden && state.updated && Date.now() - state.updated.getTime() > 15 * 60 * 1000) load();
  });

  document.addEventListener("click", function (e) {
    var b = e.target.closest("[data-act]");
    if (!b) return;
    var act = b.getAttribute("data-act"), k = b.getAttribute("data-k");
    if (act === "locate") $("locate").click();
    else if (act === "toggle") toggleSaved();
    else if (act === "home" && k) { state.home = k; refreshPersonal(); }
    else if (act === "remove" && k) {
      state.saved = state.saved.filter(function (s) { return key(s) !== k; });
      if (state.home === k) state.home = state.saved.length ? key(state.saved[0]) : null;
      refreshPersonal();
    } else if (act === "go" && k) {
      var hit = state.saved.filter(function (s) { return key(s) === k; })[0];
      if (hit) { state.place = hit; save(); load(); }
    }
  });
  $("name").addEventListener("input", function () {
    state.name = this.value.trim().slice(0, 30);
    save();
    if (state.last && state.place) renderMain(state.last.d, state.last.c);
  });

  $("auth-form").addEventListener("submit", function (e) { e.preventDefault(); submitAuth(); });
  $("auth-cancel").addEventListener("click", function () { $("auth-panel").hidden = true; });

  initCloud();
  restore();
  var startAt = homePlace();
  if (startAt) state.place = startAt;
  $("name").value = state.name;
  setUnits(state.units);
  load();
})();
</script>
</body>
</html>
